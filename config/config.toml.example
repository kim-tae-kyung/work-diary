# work-diary config example.
# Use at: ~/.config/work-diary/config.toml  (or the WORK_DIARY_CONFIG env path)
# If the file is absent, the CLI runs on built-in defaults. Unknown keys are ignored.
# Parsing config.toml requires Python ≥3.11 (tomllib).

# Daily Markdown root. Entry path is <diary_root>/YYYY/MM/YYYY-MM-DD.md.
# LaunchAgent does not guarantee a cwd, so use an absolute path.
# Caution (design §operational cautions): do not default to an iCloud/Dropbox/Git auto-sync path.
# Default (in code) is ~/Desktop/diary/diary, which macOS "Desktop & Documents" iCloud may sync.
# Uncomment and set an absolute path to override:
# diary_root = "/Users/YOUR_USERNAME/Desktop/diary/diary"

# Model (design §fixed decisions default). If your installed tag differs, check `ollama list`.
model = "gemma4:12b-it-qat"
ollama_url = "http://localhost:11434"

# Timeouts (seconds). design §lock and timeout.
api_timeout = 180     # per Ollama /api/chat call budget
total_timeout = 360   # total run budget (N per-display calls + 1 aggregation, sequential); also stale-lock detection

# Image resize longest edge (px). design §image resize policy.
# Each display is sent as its own single-image call, so this applies per display.
# Note: Ollama caps gemma vision at ~896²/image, so raising this past that gives little OCR gain.
resize_single = 1600
# resize_multi is removed — every model call is single-image now (unknown keys are ignored).
max_displays = 4      # max number of displays to attempt to capture

# On-device OCR (Apple Vision via the work-diary-ocr helper; design §OCR grounding).
# Reads real text off the full-resolution capture and feeds the most prominent lines to the model,
# so detail is grounded instead of guessed. Best-effort: if the helper is missing, runs vision-only.
# The helper is built by scripts/install.sh (needs Xcode Command Line Tools / swiftc).
use_ocr = true
ocr_languages = ["ko-KR", "en-US"]   # Vision recognition languages (BCP-47)
ocr_max_lines = 40                   # how many of the largest-font OCR lines to pass to the model
ocr_timeout = 20                     # per-image OCR subprocess budget (seconds)
# ocr_helper = "/Users/YOUR_USERNAME/.local/bin/work-diary-ocr"  # override; default auto-resolves

# Post-screening (design §post-screening). The model judges sensitivity; if its
# caution_tags contain any of these tags, the entry is redacted.
block_tags = ["secret-detected", "possibly-sensitive"]

# Skip a log line when the new summary is essentially the same as the last written one
# (design §skip). The model still runs every interval; only the duplicate line is dropped.
skip_similar = true
similarity_threshold = 0.85   # difflib ratio ≥ this ⇒ treat as a duplicate and skip the line

# Keep the latest screenshot of every display in the state dir, refreshed each run.
# false = keep nothing (more private; "volatile originals").
store_last_screenshot = true
