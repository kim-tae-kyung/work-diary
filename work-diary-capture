#!/usr/bin/env python3
"""work-diary-capture — local macOS work diary.

Captures every display, classifies the current activity with a local Ollama vision
model into one short Korean line (calendar-style time tracking: coding / research /
docs / rest …), redacts it when secrets are detected, and appends a single line per
capture (time | status | summary) to a daily Markdown file. The only input is
screenshot images. Resized/encoded images are deleted right after analysis; the
latest screenshot per display is kept in the state dir (~/Library/Application
Support/work-diary). When a summary is essentially the same as the last one, the
line is skipped. All processing stays local.

Docs: docs/PRD.md (what/why), docs/design.md (how).
Standard library only. No external dependencies.
"""
from __future__ import annotations

import argparse
import base64
import difflib
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

# ── Defaults ─────────────────────────────────────────────────────────────────

DEFAULTS = {
    "diary_root": str(Path.home() / "Desktop" / "diary" / "diary"),
    "model": "gemma4:12b-it-qat",
    "ollama_url": "http://localhost:11434",
    "api_timeout": 180,
    "total_timeout": 360,   # covers N per-display calls + 1 aggregation, run sequentially
    "resize_single": 1600,   # longest-edge px per display; every model call is single-image
    "max_displays": 4,
    # On-device OCR (Apple Vision via the work-diary-ocr helper) reads real on-screen text from the
    # full-resolution capture and feeds the most prominent lines to the model, so `detail` is grounded
    # in actual text instead of guessed. Best-effort: if the helper is missing/fails, fall back to
    # vision-only. OCR works on the captured image file, so it needs no extra permission.
    "use_ocr": True,
    "ocr_languages": ["ko-KR", "en-US"],
    "ocr_max_lines": 40,     # how many of the largest-font OCR lines to pass to the model
    "ocr_timeout": 20,       # per-image OCR subprocess budget (seconds)
    "ocr_helper": "",        # path to the helper; "" = auto-resolve next to the CLI, then PATH
    "block_tags": ["secret-detected", "possibly-sensitive"],
    # Skip a log line when the new summary is ~the same as the last written one (design §skip).
    "skip_similar": True,
    "similarity_threshold": 0.85,   # difflib ratio ≥ this ⇒ treat as a duplicate, skip the line
    # Keep the latest screenshot per display in the state dir (refreshed every run).
    "store_last_screenshot": True,
}

# Output schemas forcing Ollama to always return valid JSON (design §model request).
# Stage 1 (per display): `category` from the fixed list, `detail` a short legible hint (or ""),
# `caution_tags` drives redaction only. Stage 2 (text-only aggregation): the dominant `category` + `detail`.
MONITOR_SCHEMA = {
    "type": "object",
    "properties": {
        "category": {"type": "string"},
        "detail": {"type": "string"},
        "caution_tags": {"type": "array", "items": {"type": "string"}},
    },
    "required": ["category", "detail", "caution_tags"],
}

AGG_SCHEMA = {
    "type": "object",
    "properties": {
        "category": {"type": "string"},
        "detail": {"type": "string"},
    },
    "required": ["category", "detail"],
}

# Greedy decoding for factual screenshot summarization. The gemma model ships with
# temperature=1 by default, which makes the OCR/summary hallucinate and vary run to
# run; temperature 0 is greedy, so top_p/top_k are moot — temperature alone suffices.
MODEL_OPTIONS = {"temperature": 0}

SYSTEM_PROMPT = "You summarize screenshots into privacy-preserving work diary entries."

# Fixed activity categories. Reused in both prompts so stage 2 cannot invent new labels.
CATEGORIES = "코딩/개발, 자료 조사, 문서·PPT 작성, 이메일·메신저, 회의·영상 시청, 디자인, 휴식·비업무"

# Stage 1 — one screenshot at a time. Each display gets the model's full attention, so the
# category/coarse topic is judged per screen instead of blending all displays into one guess.
MONITOR_PROMPT = (
    "You are given ONE screenshot of a single display. Classify what is on THIS screen for "
    "calendar-style time tracking, not a detailed record.\n"
    f"Set \"category\" to exactly one of: {CATEGORIES}. "
    "If the screen is idle, locked, a wallpaper/screensaver, or essentially empty, use 휴식·비업무.\n"
    "Set \"detail\" to a brief Korean hint of the topic or main app — but ONLY if it is clearly "
    "legible. Do NOT guess or invent file names, project names, library names, versions, URLs, or "
    "any small text you cannot clearly read; when unsure, set \"detail\" to an empty string. "
    "Keep \"detail\" to a short phrase, no line breaks.\n"
    "Do not transcribe passwords, verification codes, API tokens, private message contents, "
    "email bodies, or financial/medical/legal details. "
    "If the screen looks security-sensitive, generalize and add \"possibly-sensitive\" to "
    "caution_tags. "
    "If a password/token/verification code is visible, add \"secret-detected\" to caution_tags."
)

# Stage 2 — text only, no images. Collapse the per-display findings into the single dominant
# activity. Idle/secondary screens (video, wallpaper, locked) are ignored in favour of active work.
AGG_PROMPT = (
    "Below are per-display findings for one moment, one line per display: \"category | detail\".\n"
    "{lines}\n\n"
    "Pick the SINGLE dominant activity the user is actually working on right now and report it for "
    "calendar-style time tracking. Prefer an active work screen over idle, locked, wallpaper, or "
    "video/secondary screens; if every display is idle, use 휴식·비업무.\n"
    f"Set \"category\" to exactly one of: {CATEGORIES}. "
    "Set \"detail\" to a short Korean hint drawn ONLY from the findings above — do not introduce any "
    "detail that is not present there; if none is informative, use an empty string."
)

# Appended to MONITOR_PROMPT when on-device OCR text is available for the display. The OCR text is
# real (not guessed), so the model is told to ground `detail` in it rather than invent specifics.
OCR_SECTION = (
    "\n\nText read from THIS screen by on-device OCR (Apple Vision), largest/most prominent first. "
    "It may be noisy, partial, or out of reading order. Use it to ground \"category\" and a SPECIFIC "
    "\"detail\" (app, file, project, or topic) when it is clearly relevant — prefer this real text "
    "over guessing. Still do NOT copy passwords, tokens, verification codes, or private "
    "message/email bodies into \"detail\", and still set caution_tags if secrets are visible.\n"
    "<ocr>\n{text}\n</ocr>"
)


# ── Exceptions ───────────────────────────────────────────────────────────────

class TimeoutAbort(Exception):
    """Total run timeout (SIGALRM)."""


class OllamaUnavailable(Exception):
    def __init__(self, code):
        self.code = code


class OllamaTimeout(Exception):
    pass


class ModelMissing(Exception):
    pass


class OllamaError(Exception):
    def __init__(self, code):
        self.code = code


class ParseError(Exception):
    pass


# ── Utilities ────────────────────────────────────────────────────────────────

def log(msg: str) -> None:
    """Non-sensitive status messages to stderr only. Never print images, payloads, or request bodies."""
    sys.stderr.write(f"[work-diary] {msg}\n")


def state_dir() -> Path:
    return Path.home() / "Library" / "Application Support" / "work-diary"


def state_tmp() -> Path:
    t = state_dir() / "tmp"
    t.mkdir(parents=True, exist_ok=True)
    os.chmod(t, 0o700)
    return t


def prev_dir() -> Path:
    """Holds the latest screenshot per display (shot-<i>.png) and the last summary (summary.txt)."""
    p = state_dir() / "prev"
    p.mkdir(parents=True, exist_ok=True)
    os.chmod(p, 0o700)
    return p


# ── Config loading ───────────────────────────────────────────────────────────

def load_config() -> dict:
    cfg = dict(DEFAULTS)
    path = os.environ.get("WORK_DIARY_CONFIG") or str(
        Path.home() / ".config" / "work-diary" / "config.toml"
    )
    p = Path(path)
    if p.exists():
        try:
            import tomllib
        except ModuleNotFoundError:
            log("config.toml requires Python ≥3.11 (tomllib); using built-in defaults.")
        else:
            try:
                with p.open("rb") as f:
                    user = tomllib.load(f)
                cfg.update({k: v for k, v in user.items() if k in DEFAULTS})
            except (OSError, ValueError) as e:
                log(f"config.toml parse failed ({type(e).__name__}); using built-in defaults.")
    return cfg


# ── Lock (atomic mkdir; flock not available on macOS by default) ─────────────

def acquire_lock(cfg: dict):
    state_dir().mkdir(parents=True, exist_ok=True)
    lock = state_dir() / "capture.lock"
    try:
        lock.mkdir()
    except FileExistsError:
        try:
            age = time.time() - lock.stat().st_mtime
        except FileNotFoundError:
            age = 0.0
        if age <= cfg["total_timeout"]:
            return None  # another run is in progress → exit quietly
        # stale lock → take over
        shutil.rmtree(lock, ignore_errors=True)
        try:
            lock.mkdir()
        except FileExistsError:
            return None
    try:
        (lock / "pid").write_text(str(os.getpid()))
    except OSError:
        pass
    return lock


def release_lock(lock) -> None:
    if lock is not None:
        shutil.rmtree(lock, ignore_errors=True)


# ── Capture → resize → encode ────────────────────────────────────────────────

def capture_screens(tmpdir: Path, cfg: dict) -> list[Path]:
    """Capture one image per display (including non-frontmost monitors). -x mutes the shutter.

    Scans `screencapture -D <index>` from 1 upward and stops when no file is produced.
    A failure on display 1 is treated as missing permission / capture failure.
    """
    created: list[Path] = []
    for i in range(1, max(1, int(cfg["max_displays"])) + 1):
        out = tmpdir / f"shot-{i}.png"
        subprocess.run(
            ["screencapture", "-x", "-D", str(i), str(out)],
            capture_output=True,
        )
        if out.exists() and out.stat().st_size > 0:
            created.append(out)
        elif i == 1:
            return []  # could not capture the main display → failure
        else:
            break  # no display at this index → stop scanning
    return created


def resize_image(src: Path, longest: int, tmpdir: Path) -> Path | None:
    dst = tmpdir / f"{src.stem}-r{longest}.png"
    proc = subprocess.run(
        ["sips", "-Z", str(longest), str(src), "--out", str(dst)],
        capture_output=True,
    )
    if proc.returncode != 0 or not dst.exists() or dst.stat().st_size == 0:
        return None
    return dst


def encode_b64(p: Path) -> str:
    return base64.b64encode(p.read_bytes()).decode("ascii")


# ── On-device OCR (Apple Vision via the work-diary-ocr helper) ────────────────

def ocr_helper_path(cfg: dict) -> str | None:
    """Resolve the OCR helper: explicit config → next to this CLI → PATH. None if unavailable."""
    explicit = cfg.get("ocr_helper") or ""
    if explicit:
        return explicit if Path(explicit).exists() else None
    sibling = Path(__file__).resolve().parent / "work-diary-ocr"
    if sibling.exists():
        return str(sibling)
    return shutil.which("work-diary-ocr")


def run_ocr(cfg: dict, image: Path) -> str:
    """Return the most prominent OCR lines from `image` (largest font first), or "" on any failure.

    Best-effort: a missing/failing helper degrades to vision-only. Runs on the full-resolution
    capture (not the downscaled copy) so small text stays legible — Vision is not subject to the
    model's 896² cap.
    """
    helper = ocr_helper_path(cfg)
    if not helper:
        return ""
    cmd = [helper, "--lang", ",".join(cfg["ocr_languages"]), str(image)]
    try:
        proc = subprocess.run(cmd, capture_output=True, timeout=cfg["ocr_timeout"])
    except (subprocess.TimeoutExpired, OSError):
        return ""
    if proc.returncode != 0:
        return ""
    try:
        items = json.loads(proc.stdout or b"[]")
    except (json.JSONDecodeError, TypeError):
        return ""
    if not isinstance(items, list):
        return ""
    rows = [it for it in items if isinstance(it, dict) and _one_line(it.get("t"))]
    # Tallest box first = largest font = titles / app names / headings (high signal, low body-text noise).
    rows.sort(key=lambda it: float(it.get("h") or 0), reverse=True)
    seen: set[str] = set()
    lines: list[str] = []
    for it in rows:
        t = _one_line(it["t"])
        key = t.lower()
        if key in seen:
            continue
        seen.add(key)
        lines.append(t)
        if len(lines) >= int(cfg["ocr_max_lines"]):
            break
    return "\n".join(lines)


# ── Previous frame + summary (state) ─────────────────────────────────────────

def save_last_shots(shots: list[Path]) -> None:
    """Refresh the latest screenshot per display (delete the old set, copy in the current)."""
    d = prev_dir()
    for old in d.glob("shot-*.png"):
        old.unlink(missing_ok=True)
    for i, shot in enumerate(shots, start=1):
        shutil.copy2(shot, d / f"shot-{i}.png")


def load_last_summary() -> str:
    """The last written summary, or "" if none."""
    p = prev_dir() / "summary.txt"
    try:
        return p.read_text(encoding="utf-8")
    except OSError:
        return ""


def save_last_summary(summary: str) -> None:
    (prev_dir() / "summary.txt").write_text(summary, encoding="utf-8")


def is_duplicate(summary: str, prev: str, threshold: float) -> bool:
    """True when summary is essentially the same as the previously written one."""
    if not prev:
        return False
    return difflib.SequenceMatcher(None, summary, prev).ratio() >= threshold


# ── Model call ───────────────────────────────────────────────────────────────

def ollama_call(cfg: dict, user_msg: dict, schema: dict, keep_alive) -> dict:
    """One Ollama /api/chat call. `user_msg` is the user message (with or without `images`).

    `keep_alive` controls model residency: a short positive value (e.g. "60s") keeps the model
    warm so the next call in the same run is not cold-loaded; 0 unloads after this call.
    """
    payload = {
        "model": cfg["model"],
        "stream": False,
        "keep_alive": keep_alive,
        "format": schema,
        "options": MODEL_OPTIONS,
        "messages": [
            {"role": "system", "content": SYSTEM_PROMPT},
            user_msg,
        ],
    }
    body = json.dumps(payload).encode("utf-8")
    url = cfg["ollama_url"].rstrip("/") + "/api/chat"
    req = urllib.request.Request(
        url, data=body, headers={"Content-Type": "application/json"}, method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=cfg["api_timeout"]) as resp:
            raw = resp.read()
    except urllib.error.HTTPError as e:
        if e.code == 404:  # Ollama returns 404 for a model that is not installed
            raise ModelMissing()
        raise OllamaError(f"http-{e.code}")
    except urllib.error.URLError as e:
        reason = getattr(e, "reason", None)
        if isinstance(reason, (TimeoutError, socket.timeout)):
            raise OllamaTimeout()
        if isinstance(reason, ConnectionRefusedError):
            raise OllamaUnavailable("connection-refused")
        raise OllamaUnavailable(type(reason).__name__ if reason else "url-error")
    except (TimeoutError, socket.timeout):
        raise OllamaTimeout()
    try:
        return json.loads(raw)
    except (json.JSONDecodeError, TypeError):
        raise ParseError()


def _content_obj(data: dict) -> dict:
    """Extract and JSON-parse the model's message content."""
    try:
        content = data["message"]["content"]
    except (KeyError, TypeError):
        raise ParseError()
    try:
        obj = json.loads(content)
    except (json.JSONDecodeError, TypeError):
        raise ParseError()
    if not isinstance(obj, dict):
        raise ParseError()
    return obj


def _one_line(s) -> str:
    """Collapse all whitespace (incl. newlines) so a field occupies a single log line."""
    return " ".join(str(s).split()) if isinstance(s, str) else ""


def parse_monitor(data: dict) -> dict:
    """Stage 1 result for one display: {category, detail, caution_tags}."""
    obj = _content_obj(data)
    category = _one_line(obj.get("category"))
    if not category:
        raise ParseError()
    tags = obj.get("caution_tags")
    tags = [str(t) for t in tags] if isinstance(tags, list) else []
    return {"category": category, "detail": _one_line(obj.get("detail")), "caution_tags": tags}


def parse_aggregate(data: dict) -> dict:
    """Stage 2 result: the dominant {category, detail}."""
    obj = _content_obj(data)
    category = _one_line(obj.get("category"))
    if not category:
        raise ParseError()
    return {"category": category, "detail": _one_line(obj.get("detail"))}


# ── Post-screening ───────────────────────────────────────────────────────────

def screen(cfg: dict, tags: list[str]) -> str | None:
    """Gemma judges sensitivity. Redact if a caution tag is in block_tags; return that tag, else None."""
    block = {t.lower() for t in cfg["block_tags"]}
    for t in tags:
        if t.lower() in block:
            return t.lower()
    return None


# ── Record builders ──────────────────────────────────────────────────────────

def analyzed_record(summary: str) -> dict:
    return {"status": "analyzed", "summary": summary}


def redacted_record(tag: str) -> dict:
    return {"status": "redacted", "summary": f"hidden ({tag})"}


def error_record(message, reason) -> dict:
    return {"status": "error", "summary": f"{message} [{reason}]"}


def skip_record() -> dict:
    """Sentinel: summary ~same as the last one → no log line."""
    return {"status": "skip"}


def format_line(category: str, detail: str) -> str:
    """Compose the single record line. Enforces the `category (detail)` shape; detail is optional."""
    detail = detail.strip()
    return f"{category} ({detail})" if detail else category


# ── Markdown append ──────────────────────────────────────────────────────────

def append_markdown(cfg: dict, record: dict, now: datetime | None = None) -> Path:
    now = now or datetime.now()
    day = now.strftime("%Y-%m-%d")
    path = (
        Path(cfg["diary_root"]) / now.strftime("%Y") / now.strftime("%m") / f"{day}.md"
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    new_file = not path.exists()
    # OK only for a clean analyzed entry; redacted/error both surface as NOK. The
    # internal status is kept for control flow; the summary carries the detail.
    label = "OK" if record["status"] == "analyzed" else "NOK"
    line = f"- {now.strftime('%H:%M')} | {label} | {record['summary']}\n"
    with path.open("a", encoding="utf-8") as f:
        if new_file:
            f.write(f"## {day}\n\n")
        f.write(line)
    return path


# ── Pipeline ─────────────────────────────────────────────────────────────────

def _ollama_error_record(exc: Exception, cfg: dict) -> dict:
    """Map an Ollama/parse exception to its error record (same messages as the original flow)."""
    if isinstance(exc, OllamaUnavailable):
        return error_record(
            "Ollama API call failed. Check that `ollama serve` is running.", exc.code
        )
    if isinstance(exc, OllamaTimeout):
        return error_record(
            "Ollama API response timed out. Check model cold-load and resources.", "api-timeout"
        )
    if isinstance(exc, ModelMissing):
        return error_record(
            f"Model '{cfg['model']}' not found. Run `ollama pull {cfg['model']}`.", "model-not-found"
        )
    if isinstance(exc, OllamaError):
        return error_record("Ollama returned an error.", exc.code)
    if isinstance(exc, ParseError):
        return error_record("Failed to parse model response as JSON.", "invalid-json")
    raise exc


def run_pipeline(cfg: dict, tmpdir: Path) -> dict:
    """Return exactly one record (analyzed/redacted/error/skip).

    Two stages: classify each display on its own (full per-image attention), then collapse the
    per-display findings into the single dominant activity. Privacy screening runs on the union of
    every display's caution_tags, so one sensitive screen redacts the whole line.
    """
    shots = capture_screens(tmpdir, cfg)
    if not shots:
        return error_record(
            "Screen capture failed. Check Screen Recording permission.",
            "no-image-or-permission",
        )

    # Always refresh the latest screenshot per display, regardless of what follows.
    if cfg["store_last_screenshot"]:
        save_last_shots(shots)

    # Stage 1 — one model call per display, optionally grounded by on-device OCR of the same screen.
    # OCR runs on the full-resolution capture; the model gets the single-display resize. Keep the
    # model warm between calls when there is more than one display (a single display unloads at once).
    use_ocr = bool(cfg["use_ocr"]) and ocr_helper_path(cfg) is not None
    multi = len(shots) > 1
    monitors: list[dict] = []
    tags: list[str] = []
    for i, shot in enumerate(shots):
        resized = resize_image(shot, cfg["resize_single"], tmpdir)
        if resized is None:
            return error_record("Image resize failed.", "resize-error")
        content = MONITOR_PROMPT
        if use_ocr:
            ocr_text = run_ocr(cfg, shot)
            if ocr_text:
                content += OCR_SECTION.format(text=ocr_text)
        user_msg = {"role": "user", "content": content, "images": [encode_b64(resized)]}
        try:
            parsed = parse_monitor(ollama_call(cfg, user_msg, MONITOR_SCHEMA, "60s" if multi else 0))
        except ParseError:
            log(f"display {i + 1}: unparseable response — skipping this screen")
            continue
        except (OllamaUnavailable, OllamaTimeout, ModelMissing, OllamaError) as e:
            return _ollama_error_record(e, cfg)  # systemic: every display would fail the same way
        monitors.append(parsed)
        tags.extend(parsed["caution_tags"])

    if not monitors:
        return error_record("Failed to parse model response as JSON.", "invalid-json")

    tag = screen(cfg, tags)
    if tag:
        return redacted_record(tag)

    # Stage 2 — collapse to the dominant activity. A single display needs no aggregation call.
    if len(monitors) == 1:
        category, detail = monitors[0]["category"], monitors[0]["detail"]
    else:
        lines = "\n".join(f"- {m['category']} | {m['detail']}" for m in monitors)
        user_msg = {"role": "user", "content": AGG_PROMPT.format(lines=lines)}
        try:
            agg = parse_aggregate(ollama_call(cfg, user_msg, AGG_SCHEMA, 0))
        except (OllamaUnavailable, OllamaTimeout, ModelMissing, OllamaError, ParseError) as e:
            return _ollama_error_record(e, cfg)
        category, detail = agg["category"], agg["detail"]

    summary = format_line(category, detail)

    # Skip the line when this summary is essentially the same as the last written one.
    if cfg["skip_similar"] and is_duplicate(
        summary, load_last_summary(), float(cfg["similarity_threshold"])
    ):
        return skip_record()
    return analyzed_record(summary)


def capture_once(cfg: dict) -> int:
    lock = acquire_lock(cfg)
    if lock is None:
        log("Previous run in progress — exiting")
        return 0

    tmpdir = Path(tempfile.mkdtemp(dir=state_tmp()))
    record = None
    signal.signal(signal.SIGALRM, lambda *_: (_ for _ in ()).throw(TimeoutAbort()))
    signal.alarm(int(cfg["total_timeout"]))
    try:
        record = run_pipeline(cfg, tmpdir)
    except TimeoutAbort:
        record = error_record("Run exceeded total timeout.", "total-timeout")
    except Exception as e:  # R5: no failure disappears silently.
        record = error_record("Failed due to an unexpected error.", type(e).__name__)
    finally:
        signal.alarm(0)
        # The per-run temp dir (originals + resized images) is deleted regardless of outcome;
        # only the latest screenshot per display persists, under the state dir.
        shutil.rmtree(tmpdir, ignore_errors=True)
        release_lock(lock)

    if record.get("status") == "skip":
        log("skip — summary ~same as the last entry; no line written")
        return 0

    path = append_markdown(cfg, record)
    if record["status"] == "analyzed":
        save_last_summary(record["summary"])
    log(f"wrote: {record['status']} → {path}")
    return 0


# ── Entry point ──────────────────────────────────────────────────────────────

def main(argv=None) -> int:
    parser = argparse.ArgumentParser(
        prog="work-diary-capture", description="Local work-diary capture CLI"
    )
    sub = parser.add_subparsers(dest="cmd")
    sub.add_parser(
        "capture-once", help="Capture and summarize the screen once; append to the daily Markdown."
    )
    args = parser.parse_args(argv)

    if args.cmd == "capture-once":
        return capture_once(load_config())

    parser.print_help()
    return 2


if __name__ == "__main__":
    sys.exit(main())
