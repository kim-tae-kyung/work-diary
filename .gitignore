# Diary data (personal records) — never commit with the code.
/diary/

# Runtime logs (regenerated by the LaunchAgent each run)
/logs/

# Local config (no secrets, but contains a personal path)
config.toml

# Python bytecode caches
__pycache__/
*.pyc

# Compiled OCR helper (built by scripts/install.sh into ~/.local/bin; ignore any local build)
/work-diary-ocr

# macOS / editor cruft
.DS_Store
